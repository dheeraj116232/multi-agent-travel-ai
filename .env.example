# LLM provider
# Groq is used first when configured.
GROQ_API_KEY=

# Optional fallback provider used when GROQ_API_KEY is not set.
OPENAI_API_KEY=

# External travel/search APIs
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=

# PostgreSQL persistence
# Example:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/langgraph_memory_demo
DATABASE_URL=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CALLS=4

# App environment
ENV=development
PORT=8501
